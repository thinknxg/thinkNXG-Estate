   "fieldtype": "Section Break",
   "label": "Usage and Budget"
  },
  {
   "default": 0,
   "fieldname": "llm_enabled",
   "fieldtype": "Check",
   "label": "Use AI in the Voice CRM",
   "description": "Intent fallback, translation, summaries, sentiment and scoring. The website chat assistant is switched on in Portal Chat Settings."
  },
  {
   "default": 0,
   "fieldname": "voice_enabled",
   "fieldtype": "Check",
   "label": "Enable Voice Processing"
  },
  {
   "default": 0.6,
   "description": "Below this, ask the user to clarify instead of acting",
   "fieldname": "llm_confidence_threshold",
   "fieldtype": "Float",
   "label": "Intent Confidence Threshold"
  },
  {
   "fieldname": "col_break_1",
   "fieldtype": "Column Break"
  },
  {
   "description": "Shared by the chat assistant and the voice CRM. When it is used up, AI features pause until next month and the system falls back to its non-AI behaviour. Empty = no cap.",
