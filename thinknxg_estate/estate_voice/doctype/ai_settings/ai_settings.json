   "fieldname": "asr_provider",
   "fieldtype": "Select",
   "label": "Speech Provider",
   "options": "OpenAI Whisper API\nLocal Whisper\nNone"
  },
  {
   "description": "Base URL for local Whisper, e.g. http://localhost:9000",
