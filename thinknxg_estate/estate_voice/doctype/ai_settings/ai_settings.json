 "fields": [
  {
   "fieldname": "llm_sb",
   "fieldtype": "Section Break",
   "label": "AI Provider",
   "description": "One provider, key and budget for every AI feature: the website chat assistant and the voice CRM (intent, translation, summaries, sentiment, scoring)."
  },
  {
   "default": "None",
   "fieldname": "llm_provider",
   "fieldtype": "Select",
   "label": "Provider",
   "options": "Anthropic\nOpenAI\nGemini\nCustom\nNone",
   "description": "Custom = any OpenAI-compatible chat completions endpoint (set the endpoint below)."
  },
  {
   "fieldname": "llm_endpoint",
   "fieldtype": "Data",
   "label": "Endpoint",
   "description": "Leave empty for the provider's standard endpoint. Required for Custom."
  },
  {
   "fieldname": "api_key",
   "fieldtype": "Password",
   "label": "API Key"
  },
  {
   "fieldname": "col_break_3",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "llm_model",
   "fieldtype": "Data",
   "label": "Default Model",
   "description": "Used by the voice CRM, and by the chat assistant unless a chat model is set. Empty = the provider's default."
  },
  {
   "fieldname": "chat_model",
   "fieldtype": "Data",
   "label": "Chat Assistant Model",
   "description": "Optional: a faster or cheaper model for the website chat assistant."
  },
  {
   "fieldname": "input_cost_per_mtok",
   "fieldtype": "Float",
   "label": "Input Cost per Million Tokens",
   "description": "In the budget's currency. Used to track spend against the monthly budget."
  },
  {
   "fieldname": "output_cost_per_mtok",
   "fieldtype": "Float",
   "label": "Output Cost per Million Tokens"
  },
  {
